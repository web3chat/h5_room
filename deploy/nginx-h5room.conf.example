# h5_room — nginx HTTPS 入口示例
#
# 用法:
#   1. 把 room.example.com 全部替换为实际域名 (DNS A/AAAA 记录指向服务器公网 IP)
#   2. 先只启用 80 端口的 server 块, 用 certbot 申请证书:
#        sudo certbot certonly --nginx -d room.example.com
#   3. 证书就绪后再启用 443 块:
#        sudo ln -s /etc/nginx/sites-available/h5room /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#
# 架构: /rtc → LiveKit 7880 (WebSocket 信令); / → Go 后端 3000 (H5 + API)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name room.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name room.example.com;

    ssl_certificate     /etc/letsencrypt/live/room.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/room.example.com/privkey.pem;

    client_max_body_size 8m;

    # LiveKit 信令: WS /rtc + HTTP /rtc/validate
    location /rtc {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # H5 页面 + Go API
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # 后端用 X-Forwarded-Host 把 token 里的 wss://127.0.0.1:443
        # 改写成 wss://<真实域名>:443
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
